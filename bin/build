#!/bin/sh
# Builds build/Agent Screen.app, a menu bar app with no Dock icon.
set -eu
cd "$(dirname "$0")/.."

swift build -c release --product AgentScreen
app="build/Agent Screen.app"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS"
cp .build/release/AgentScreen "$app/Contents/MacOS/AgentScreen"
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>AgentScreen</string>
  <key>CFBundleIdentifier</key><string>tech.nowadays.agent-screen</string>
  <key>CFBundleName</key><string>Agent Screen</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.1</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSMinimumSystemVersion</key><string>15.0</string>
  <key>LSUIElement</key><true/>
</dict>
</plist>
PLIST
codesign --force --sign - "$app"
echo "$app"
